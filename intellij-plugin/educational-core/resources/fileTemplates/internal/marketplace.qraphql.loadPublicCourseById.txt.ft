query {
  plugins(
    search: {
      filters: [{ field: "id", value: ${courseId} }]
    }
  ) {
    total
    plugins {
      id
      name
      description
      downloads
      rating
      fields
      authors {
        name
      }
      organization {
        name
        url
      }
      lastUpdateDate
      cdate
      link
      license
    }
  }
}